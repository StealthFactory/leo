#!/usr/bin/env node
// leo: TODO — one-line description of `leo {{.Name}}` (shown in `leo help`)
//
// Invoked as: leo {{.Name}} [args...]   (this file is `leo-{{.Name}}`)
// Env from leo: LEO_BIN, LEO_STORE, LEO_CONFIG, LEO_COMMAND_PATHS
const { execFileSync } = require("node:child_process");
const leo = process.env.LEO_BIN || "leo";
const args = process.argv.slice(2);

if (args[0] === "-h" || args[0] === "--help") {
  console.log("Usage: leo {{.Name}} [args...]"); process.exit(0);
}

// Example: use the object store
//   execFileSync(leo, ["store", "set", "{{.Name}}.last", args.join(" ")], { stdio: "inherit" });
//   execFileSync(leo, ["store", "get", "{{.Name}}.last"], { stdio: "inherit" });

console.log("leo {{.Name}}:", ...args);
