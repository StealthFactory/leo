#!/usr/bin/env python3
# leo: TODO — one-line description of `leo {{.Name}}` (shown in `leo help`)
#
# Invoked as: leo {{.Name}} [args...]   (this file is `leo-{{.Name}}`)
# Env from leo: LEO_BIN, LEO_STORE, LEO_CONFIG, LEO_COMMAND_PATHS
import os, subprocess, sys

LEO = os.environ.get("LEO_BIN", "leo")

def main(argv):
    if argv[:1] in (["-h"], ["--help"]):
        print("Usage: leo {{.Name}} [args...]"); return 0
    # Example: use the object store
    #   subprocess.run([LEO, "store", "set", "{{.Name}}.last", " ".join(argv)], check=True)
    #   print(subprocess.run([LEO, "store", "get", "{{.Name}}.last"],
    #                        text=True, capture_output=True).stdout, end="")
    print("leo {{.Name}}:", *argv)
    return 0

if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
